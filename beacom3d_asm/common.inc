; =============================================================================
; common.inc -- shared constants, macros and cross-module symbols for
;               "Beacom at 2am" (3D assembly edition)
;
; x86-64 NASM, System V ABI, linked with gcc -no-pie against
; SDL2, SDL2_image, SDL2_ttf, OpenGL and libm.
;
; Conventions used in every .asm file of this project
;   * integer args: rdi, rsi, rdx, rcx, r8, r9   -> result in rax/eax
;   * float args:   xmm0..xmm7 (single precision) -> result in xmm0
;   * rbx, rbp, r12-r15 are callee saved; everything else is scratch
;   * rsp must be 16-byte aligned at every `call`
;   * non-leaf functions use PROLOGUE n / EPILOGUE, which saves all
;     callee-saved registers and reserves n bytes of locals at [rsp]
;   * "leaf" helpers (no calls) skip the frame and only touch scratch regs
;
; World units: one grid cell is CELL (2.0) units square, one storey is
; FH (3.2) units tall.  world X = grid x * CELL, world Z = grid y * CELL,
; world Y is height.  Floor 0 = basement, 1 = ground (board.txt), 2 = second.
; =============================================================================

default rel

; ---- two build targets --------------------------------------------------------
; Linux: nasm -f elf64.  Windows: nasm -f win64 -DWIN64.
; The code itself is identical: it always calls functions the System V way.
; On Windows every external function name is %defined to a small thunk (in
; win64_thunks.asm, generated by tools/gen_win64_thunks.js) that moves the
; arguments into Microsoft x64 registers and calls the real function.
%macro RODATA 0
%ifdef WIN64
section .rdata rdata align=16
%else
section .rodata
%endif
%endmacro
%ifdef WIN64
%include "win64_names.inc"
%define main beacom_main             ; SDL2main owns the real main()
%endif


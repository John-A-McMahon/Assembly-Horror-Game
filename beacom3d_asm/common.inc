; ---- frame macros -------------------------------------------------------------
; PROLOGUE n : saves rbp,rbx,r12-r15 and reserves n bytes (n multiple of 16)
;              of locals addressed as [rsp+0 .. rsp+n). rsp stays 16-aligned.
%macro PROLOGUE 1
    push rbp
    mov rbp, rsp
    push rbx
    push r12
    push r13
    push r14
    push r15
    sub rsp, %1 + 8
%endmacro

%macro EPILOGUE 0
    lea rsp, [rbp-40]
    pop r15
    pop r14
    pop r13
    pop r12
    pop rbx
    pop rbp
    ret
%endmacro

; load a float constant into an xmm register:  FLD xmm0, 1.5
%macro FLD 2
    mov eax, __float32__(%2)
    movd %1, eax
%endmacro

; ---- shared float constants (each object gets its own read-only copy) ---------
RODATA
align 16
c_zero      dd 0.0
c_one       dd 1.0
c_half      dd 0.5
c_two       dd 2.0
c_neg_one   dd -1.0
c_cell      dd 2.0
c_inv_cell  dd 0.5
c_fh        dd 3.2
c_big       dd 1.0e30
c_neg_big   dd -1.0e30
c_pi        dd 3.14159265
c_two_pi    dd 6.2831853
c_rad2deg   dd 57.2957795
c_inv_rand  dd 4.656612873e-10       ; 1 / 2^31 (for rand() -> 0..1)
c_pct       dd 0.01                  ; settings percentages -> factors
align 16
c_abs_mask  dd 0x7fffffff, 0x7fffffff, 0x7fffffff, 0x7fffffff
c_sign_mask dd 0x80000000, 0x80000000, 0x80000000, 0x80000000
section .text

